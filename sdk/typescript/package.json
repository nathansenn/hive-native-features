{
  "name": "@nathansenn/hive-native-features",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK stubs for hive-native-features (NFT, HTLC, contracts) — field names aligned with C++ protocol headers",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hive",
    "nft",
    "htlc",
    "contracts",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nathansenn/hive-native-features.git",
    "directory": "sdk/typescript"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
